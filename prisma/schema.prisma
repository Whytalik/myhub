generator client {
  provider = "prisma-client-js"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String             @id @default(cuid())
  name                    String?
  email                   String?            @unique
  emailVerified           DateTime?
  image                   String?
  passwordHash            String?
  privateTaskPasswordHash String?
  dailyResistanceBudget   Int                @default(8)
  // When the weekly review is due: weekday (0 = Sunday) and "HH:mm" local time.
  weeklyReviewDay         Int                @default(0)
  weeklyReviewTime        String             @default("20:00")
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  systemStatus            SystemStatus       @default(STABLE)
  accounts                Account[]
  dailyEntries            DailyEntry[]
  habits                  Habit[]
  habitChains             HabitChain[]
  lifeSpheres             LifeSphere[]
  sphereGoals             SphereGoal[]
  yearFocuses             YearFocus[]
  goalPlaybooks           GoalPlaybook[]
  pushSubscriptions       PushSubscription[]
  sessions                Session[]
  sprints                 Sprint[]
  tasks                   Task[]
  projects                Project[]
  weekTemplates           WeekTemplate[]
  exercises               Exercise[]
  trainingPlans           TrainingPlan[]
  trainingDays            TrainingDay[]
  trainingDayExercises    TrainingDayExercise[]
  trainingSessions        TrainingSession[]
  setLogs                 SetLog[]
  thoughtStatuses         ThoughtStatus[]
  thoughts                Thought[]
  mission                 Mission?
}

model WeekTemplate {
  id            String       @id @default(cuid())
  userId        String
  dayOfWeek     Int
  trainingDayId String?
  contextBlocks Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingDay   TrainingDay? @relation(fields: [trainingDayId], references: [id], onDelete: SetNull)

  @@unique([userId, dayOfWeek])
  @@index([userId])
  @@index([trainingDayId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Not user-owned: "vitalii"/"olesia" are static nutrition profile keys
// (see PROFILES in src/features/health/nutrition/data.ts), not separate
// NextAuth users — this household shares one login.
model FatSecretAccount {
  id                String   @id @default(cuid())
  profileId         String   @unique
  accessToken       String
  accessTokenSecret String
  linkedAt          DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Also not user-owned — see FatSecretAccount comment above. Maps internal
// PRODUCTS keys (src/features/health/nutrition/products.ts) to FatSecret
// food/serving ids, overriding the static seed in fatsecret-mapping.ts.
model ProductFatSecretMapping {
  id                 String        @id @default(cuid())
  productKey         String        @unique
  foodId             String
  foodName           String
  servingId          String
  servingDescription String
  /** Множник для food_entry.create (numberOfUnits = grams / servingGrams) — 1 для "g"/"ml" servings (FatSecret тоді трактує number_of_units як грами напряму), інакше = macroGrams. НЕ перевикористовувати для розрахунку макросів. */
  servingGrams       Float         @default(1)
  /** Скільки грамів представляють збережені kcal/protein/fat/carbs (metric_serving_amount) — база для перерахунку на 100г. */
  macroGrams         Float         @default(0)
  /** Макроси serving'у, як повернув FatSecret на момент мапування — для порівняння з ціллю. */
  kcal               Float         @default(0)
  protein            Float         @default(0)
  fat                Float         @default(0)
  carbs              Float         @default(0)
  source             MappingSource @default(MANUAL)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

enum MappingSource {
  MANUAL
  BARCODE
}

// Also not user-owned — see FatSecretAccount comment above. Tracks Saved Meals
// (FatSecret's own "pick a dish instead of individual foods" feature) provisioned
// into each profile's real FatSecret account from a WEEK_PLAN slot, so re-running
// the provisioning script can replace the old FatSecret-side saved meal instead of
// creating a duplicate when the plan changes.
model FatSecretSavedMeal {
  id          String   @id @default(cuid())
  profileId   String
  season      String // "summer" | "winter" | "autumn" | "spring"
  weekday     String // SetId from types.ts, e.g. "set3" (was a Weekday like "fri" pre-sets redesign)
  // Index of the meal within DayPlan.meals — NOT mealType, because a single day
  // can have two meals sharing the same MealType (e.g. Friday has two "snack"
  // meals: "Передтрен" and "Перекус"); keying on mealType alone collapsed them
  // into one slot and caused the provisioning script to delete+overwrite one
  // with the other on every run.
  mealSlot    Int
  mealType    String // MealType from types.ts, e.g. "breakfast" — informational only
  title       String // last title pushed to FatSecret — for display/debugging only
  savedMealId String // FatSecret's saved_meal_id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([profileId, season, weekday, mealSlot])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LifeSphere {
  id         String      @id @default(cuid())
  userId     String
  name       String
  color      String
  icon       String
  order      Int         @default(0)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  habits     Habit[]
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectives Objective[]
  tasks      Task[]
  thoughts   Thought[]
  goals      SphereGoal[]
  yearFocuses YearFocus[]

  @@index([userId])
}

// Yearly measurable goal of a life sphere (3-5 per sphere). COUNTER and DAYS
// are lead indicators (actions taken), VALUE is a lag indicator (e.g. weight).
// When habitId is set, COUNTER/DAYS progress is derived from HabitCompletion.
model SphereGoal {
  id           String            @id @default(cuid())
  userId       String
  sphereId     String
  year         Int
  title        String
  type         SphereGoalType
  unit         String?
  startValue   Float             @default(0)
  targetValue  Float
  currentValue Float             @default(0)
  habitId      String?
  order        Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sphere       LifeSphere        @relation(fields: [sphereId], references: [id], onDelete: Cascade)
  habit        Habit?            @relation(fields: [habitId], references: [id], onDelete: SetNull)
  slices       SprintGoalSlice[]
  focusLevers  YearFocus[]
  playbook     GoalPlaybook?
  projects     Project[]
  objectives   Objective[]

  @@index([userId, year])
  @@index([sphereId])
  @@index([habitId])
}

// The 12-step plan for one yearly goal: path, behaviour change, assets,
// obstacles with solutions, people, monthly phases and the 5-minute "pedal".
// Weekly/monthly execution reuses Projects (Project.goalId) and Tasks.
model GoalPlaybook {
  id          String      @id @default(cuid())
  userId      String
  goalId      String      @unique
  path        String?
  keyChange   String?
  assets      Json?
  obstacles   Json?
  people      Json?
  pedalAction String?
  pedalTaskId String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        SphereGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  phases      GoalPhase[]

  @@index([userId])
}

model GoalPhase {
  id         String       @id @default(cuid())
  playbookId String
  title      String
  startMonth Int
  endMonth   Int
  outcome    String?
  order      Int          @default(0)
  done       Boolean      @default(false)
  createdAt  DateTime     @default(now())
  playbook   GoalPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([playbookId])
}

// The ONE sphere a user commits to for a year. Everything else runs in
// maintenance mode. leverGoal is the yearly goal expected to pull the rest.
model YearFocus {
  id             String      @id @default(cuid())
  userId         String
  year           Int
  sphereId       String
  identity       String?
  leverGoalId    String?
  leverReason    String?
  allowImperfect String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sphere         LifeSphere  @relation(fields: [sphereId], references: [id], onDelete: Cascade)
  leverGoal      SphereGoal? @relation(fields: [leverGoalId], references: [id], onDelete: SetNull)

  @@unique([userId, year])
  @@index([sphereId])
}

// The part of a yearly goal a single sprint is responsible for. Sprint
// progress = goal value now - baselineValue.
model SprintGoalSlice {
  id            String     @id @default(cuid())
  goalId        String
  sprintId      String
  targetValue   Float
  baselineValue Float
  createdAt     DateTime   @default(now())
  goal          SphereGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  sprint        Sprint     @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@unique([goalId, sprintId])
  @@index([sprintId])
}

enum SphereGoalType {
  COUNTER
  DAYS
  VALUE
}


model Task {
  id                String       @id @default(cuid())
  userId            String
  title             String
  description       String?
  icon              String?
  status            TaskStatus   @default(TODO)
  priority          TaskPriority @default(MEDIUM)
  isPrivate         Boolean      @default(false)
  plannedDate       DateTime?
  hasPlannedTime    Boolean      @default(false)
  plannedEndDate    DateTime?
  hasPlannedEndTime Boolean      @default(false)
  dueDate           DateTime?
  hasDueTime        Boolean      @default(false)
  depth             Int          @default(0)
  order             Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  parentId          String?
  sphereId          String?
  projectId         String?
  completedAt       DateTime?
  carriedFromDate   DateTime?
  carryOverReason   String?
  isBlocked         Boolean      @default(false)
  isFrog            Boolean      @default(false)
  resistance        Int?
  parent            Task?        @relation("TaskChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children          Task[]       @relation("TaskChildren")
  project           Project?     @relation(fields: [projectId], references: [id])
  sphere            LifeSphere?  @relation(fields: [sphereId], references: [id])
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([parentId])
  @@index([sphereId])
  @@index([projectId])
  @@index([plannedDate])
}

model DailyEntry {
  id              String    @id @default(cuid())
  userId          String
  date            DateTime  @db.Date
  sleepBedtime    DateTime?
  sleepWakeup     DateTime?
  sleepHours      Float?
  sleepQuality    Int?
  sleepNote       String?
  energy          Int?
  mood            Int?
  emotions        Json?
  weight          Float?
  energyNote      String?
  eveningEnergy   Int?
  eveningMood     Int?
  nutrition       Int?
  nutritionNote   String?
  morningRoutine  Json?
  eveningRoutine  Json?
  routineNote     String?
  trainingDayName String?
  gymSkipped      Boolean   @default(false)
  gymSkipReason   String?
  winToday        String?
  improveTomorrow String?
  gratitude       String?
  frictionToday   String?
  confidenceLog   Json?
  postAnalysisTrigger       String?
  postAnalysisMyReaction    String?
  postAnalysisBetterResponse String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  standupPlan     String?
  dailyVector     Json?
  recoveryRoutine Json?
  recoveryScore   Float?
  pdcaLog         Json?
  startedAt       DateTime?
  completedAt     DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

enum SphereLevel {
  MINIMUM
  MEDIUM
  DESIRED
}

model Habit {
  id           String            @id @default(cuid())
  userId       String
  name         String
  type         String            @default("positive")
  anchor       String
  action       String
  celebration  String?
  reminderTime String?
  order        Int               @default(0)
  archived          Boolean      @default(false)
  scheduledWeekdays Int[]        @default([0, 1, 2, 3, 4, 5, 6])
  sphereLevel  SphereLevel?
  subcategory  String?
  ifThenPlan        String?
  frictionReduction String?
  identityStatement String?
  minimalThreshold  String?
  copingPlan        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sphereId     String?
  sphere       LifeSphere?       @relation(fields: [sphereId], references: [id])
  chainId      String?
  chain        HabitChain?       @relation(fields: [chainId], references: [id], onDelete: SetNull)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions  HabitCompletion[]
  goals        SphereGoal[]

  @@index([userId])
  @@index([sphereId])
  @@index([chainId])
}

model HabitChain {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  order       Int      @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits      Habit[]

  @@index([userId])
}

model HabitCompletion {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}




model Sprint {
  id         String         @id @default(cuid())
  userId     String
  number     Int
  year       Int
  startDate  DateTime
  endDate    DateTime
  status     SprintStatus   @default(PLANNED)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  objectives Objective[]
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews    SprintReview[]
  afterAction SprintAfterAction?
  goalSlices SprintGoalSlice[]

  @@index([userId])
}

model Objective {
  id          String          @id @default(cuid())
  sprintId    String
  sphereId    String
  goalId      String?
  title       String
  description String?
  status      ObjectiveStatus @default(IN_PROGRESS)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  sphere      LifeSphere      @relation(fields: [sphereId], references: [id], onDelete: Cascade)
  sprint      Sprint          @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  goal        SphereGoal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  projects    Project[]

  @@index([sprintId])
  @@index([sphereId])
  @@index([goalId])
}


model Project {
  id          String     @id @default(cuid())
  userId      String
  objectiveId String?
  goalId      String?
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      TaskStatus @default(TODO)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  goal        SphereGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@index([userId])
  @@index([objectiveId])
  @@index([goalId])
}



model SprintReview {
  id           String   @id @default(cuid())
  sprintId     String
  weekNumber   Int
  date         DateTime @db.Date
  score        Float?
  wins         String?
  challenges   String?
  adjustments  String?
  kaizenVector Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sprint       Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([sprintId])
}

model SprintAfterAction {
  id          String   @id @default(cuid())
  sprintId    String   @unique
  date        DateTime @db.Date
  whatWorked  String?
  challenges  String?
  adjustments String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sprint      Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([sprintId])
}

enum SystemStatus {
  STABLE
  CRISIS_SURVIVAL
  CRISIS_STABILIZATION
  CRISIS_RE_ENTRY
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ObjectiveStatus {
  IN_PROGRESS
  ACHIEVED
  PARTIAL
  FAILED
  CANCELLED
}


model Exercise {
  id                String                @id @default(cuid())
  userId            String
  name              String
  muscleGroup       String?
  equipment         String?
  trackingType      String                @default("weight_reps")
  notes             String?
  explanation       String?
  technique         String?
  videoUrl          String?
  scientificInsight String?
  progression       String?
  archived          Boolean               @default(false)
  order             Int                   @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayExercises      TrainingDayExercise[]
  setLogs           SetLog[]

  @@index([userId])
}

model TrainingPlan {
  id          String        @id @default(cuid())
  userId      String
  name        String
  description String?
  archived    Boolean       @default(false)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  days        TrainingDay[]

  @@index([userId])
}

model TrainingDay {
  id        String                @id @default(cuid())
  userId    String
  planId    String
  name      String
  notes     String?
  order     Int                   @default(0)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          TrainingPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises     TrainingDayExercise[]
  sessions      TrainingSession[]
  weekTemplates WeekTemplate[]

  @@index([userId])
  @@index([planId])
}

model TrainingDayExercise {
  id                    String       @id @default(cuid())
  userId                String
  dayId                 String
  exerciseId            String
  order                 Int          @default(0)
  sets                  Int          @default(3)
  targetReps            Int?
  targetWeight          Float?
  targetRpe             Float?
  targetRir             Float?
  restSeconds           Int?
  targetDurationSeconds Int?
  targetDistanceMeters  Float?
  goal                  String       @default("hypertrophy")
  notes                 String?
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  day                   TrainingDay  @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise              Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dayId])
  @@index([exerciseId])
}

model TrainingSession {
  id              String           @id @default(cuid())
  userId          String
  dayId           String?
  dayName         String
  date            DateTime         @default(now())
  status          String           @default("in_progress")
  durationSeconds Int?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  day             TrainingDay?     @relation(fields: [dayId], references: [id], onDelete: SetNull)
  setLogs         SetLog[]

  @@index([userId])
  @@index([dayId])
}

model SetLog {
  id              String          @id @default(cuid())
  userId          String
  sessionId       String
  exerciseId      String
  exerciseName    String
  setNumber       Int
  reps            Int?
  weight          Float?
  rpe             Float?
  rir             Float?
  restSeconds     Int?
  durationSeconds Int?
  distanceMeters  Float?
  completed       Boolean         @default(false)
  isWarmup        Boolean         @default(false)
  skipped         Boolean         @default(false)
  skipReason      String?
  notes           String?
  order           Int             @default(0)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session         TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise        Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([exerciseId])
}

model ThoughtStatus {
  id        String    @id @default(cuid())
  userId    String
  name      String
  color     String    @default("#6fbfbf")
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  thoughts  Thought[]

  @@index([userId])
}

model Thought {
  id           String        @id @default(cuid())
  userId       String
  statusId     String
  content      String
  order        Int           @default(0)
  type         ThoughtType?
  templateData Json?
  urgency      ThoughtUrgency?
  sphereId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       ThoughtStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  sphere       LifeSphere?   @relation(fields: [sphereId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([statusId])
  @@index([sphereId])
}

// Set by the Prime Filter's "when?" question. Null = not triaged, or Someday
// (which is its own status, not an urgency level).
enum ThoughtUrgency {
  URGENT
  SOON
}

enum ThoughtType {
  WORRY_PROBLEM
  IDEA_DREAM
  TASK_DEADLINE
}

// A single living document per user (Covey) — "current mission" is the
// document itself, edited in place on every save. One row, no version log.
model Mission {
  id        String   @id @default(cuid())
  userId    String   @unique
  content   String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
