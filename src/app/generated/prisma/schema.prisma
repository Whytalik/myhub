generator client {
  provider = "prisma-client-js"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String             @id @default(cuid())
  name                    String?
  email                   String?            @unique
  emailVerified           DateTime?
  image                   String?
  passwordHash            String?
  privateTaskPasswordHash String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  systemStatus            SystemStatus       @default(STABLE)
  accounts                Account[]
  annualCompasses         AnnualCompass[]
  dailyEntries            DailyEntry[]
  habits                  Habit[]
  lifeSpheres             LifeSphere[]
  milestones              Milestone[]
  pushSubscriptions       PushSubscription[]
  sessions                Session[]
  sprints                 Sprint[]
  tasks                   Task[]
  visions                 Vision[]
  weekTemplates           WeekTemplate[]
}

model WeekTemplate {
  id        String   @id @default(cuid())
  userId    String
  dayOfWeek Int // 0=Mon, 1=Tue, 2=Wed, 3=Thu, 4=Fri, 5=Sat, 6=Sun
  dayType   String   @default("regular")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LifeSphere {
  id         String      @id @default(cuid())
  userId     String
  name       String
  color      String
  icon       String
  order      Int         @default(0)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  habits     Habit[]
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  objectives Objective[]
  tasks      Task[]

  @@index([userId])
}

model Task {
  id                String       @id @default(cuid())
  userId            String
  title             String
  description       String?
  icon              String?
  status            TaskStatus   @default(TODO)
  priority          TaskPriority @default(MEDIUM)
  isPrivate         Boolean      @default(false)
  plannedDate       DateTime?
  hasPlannedTime    Boolean      @default(false)
  plannedEndDate    DateTime?
  hasPlannedEndTime Boolean      @default(false)
  dueDate           DateTime?
  hasDueTime        Boolean      @default(false)
  depth             Int          @default(0)
  order             Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  parentId          String?
  sphereId          String?
  projectId         String?
  completedAt       DateTime?
  carriedFromDate   DateTime?
  carryOverReason   String?
  isBlocked         Boolean      @default(false)
  isFrog            Boolean      @default(false)
  parent            Task?        @relation("TaskChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children          Task[]       @relation("TaskChildren")
  project           Project?     @relation(fields: [projectId], references: [id])
  sphere            LifeSphere?  @relation(fields: [sphereId], references: [id])
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([parentId])
  @@index([sphereId])
  @@index([projectId])
  @@index([plannedDate])
}

model DailyEntry {
  id              String    @id @default(cuid())
  userId          String
  date            DateTime  @db.Date
  sleepBedtime    DateTime?
  sleepWakeup     DateTime?
  sleepHours      Float?
  sleepQuality    Int?
  sleepNote       String?
  energy          Int?
  mood            Int?
  emotions        Json?
  weight          Float?
  energyNote      String?
  eveningEnergy   Int?
  nutrition       Int?
  nutritionNote   String?
  morningRoutine  Json?
  eveningRoutine  Json?
  routineNote     String?
  winToday        String?
  improveTomorrow String?
  gratitude       String?
  brainDump       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  standupBlockers String?
  standupDone     String?
  standupPlan     String?
  recoveryRoutine Json?
  recoveryScore   Float?
  startedAt       DateTime?
  completedAt     DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

enum SphereLevel {
  MINIMUM
  MEDIUM
  DESIRED
}

model Habit {
  id                String            @id @default(cuid())
  userId            String
  name              String
  type              String            @default("positive")
  anchor            String
  action            String
  celebration       String?
  reminderTime      String?
  order             Int               @default(0)
  archived          Boolean           @default(false)
  targetDaysPerWeek Int               @default(7)
  sphereLevel       SphereLevel?
  subcategory       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  sphereId          String?
  sphere            LifeSphere?       @relation(fields: [sphereId], references: [id])
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions       HabitCompletion[]

  @@index([userId])
  @@index([sphereId])
}

model HabitCompletion {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model Vision {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AnnualCompass {
  id         String   @id @default(cuid())
  userId     String
  year       Int
  theme      String?
  wigs       String?
  focusAreas String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
}

model Milestone {
  id          String      @id @default(cuid())
  userId      String
  title       String
  description String?
  targetDate  DateTime?
  completed   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  sphereId    String?
  sphere      LifeSphere? @relation(fields: [sphereId], references: [id])
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sphereId])
}

model Sprint {
  id         String         @id @default(cuid())
  userId     String
  number     Int
  year       Int
  startDate  DateTime
  endDate    DateTime
  status     SprintStatus   @default(PLANNED)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  objectives Objective[]
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews    SprintReview[]

  @@index([userId])
}

model Objective {
  id          String          @id @default(cuid())
  sprintId    String
  sphereId    String
  title       String
  description String?
  status      ObjectiveStatus @default(IN_PROGRESS)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  keyResults  KeyResult[]
  sphere      LifeSphere      @relation(fields: [sphereId], references: [id], onDelete: Cascade)
  sprint      Sprint          @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  projects    Project[]

  @@index([sprintId])
  @@index([sphereId])
}

model KeyResult {
  id           String    @id @default(cuid())
  objectiveId  String
  title        String
  targetValue  Float
  currentValue Float     @default(0)
  unit         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  objective    Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  tactics      Tactic[]

  @@index([objectiveId])
}

model Project {
  id          String     @id @default(cuid())
  objectiveId String
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      TaskStatus @default(TODO)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  objective   Objective  @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([objectiveId])
}

model Tactic {
  id          String             @id @default(cuid())
  keyResultId String
  title       String
  description String?
  frequency   TacticFrequency    @default(WEEKLY)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  keyResult   KeyResult          @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  completions TacticCompletion[]

  @@index([keyResultId])
}

model TacticCompletion {
  id         String   @id @default(cuid())
  tacticId   String
  weekNumber Int
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  tactic     Tactic   @relation(fields: [tacticId], references: [id], onDelete: Cascade)

  @@unique([tacticId, weekNumber])
}

model SprintReview {
  id          String   @id @default(cuid())
  sprintId    String
  weekNumber  Int
  date        DateTime @db.Date
  score       Float?
  wins        String?
  challenges  String?
  adjustments String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sprint      Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([sprintId])
}

enum SystemStatus {
  STABLE
  CRISIS_SURVIVAL
  CRISIS_STABILIZATION
  CRISIS_RE_ENTRY
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ObjectiveStatus {
  IN_PROGRESS
  ACHIEVED
  PARTIAL
  FAILED
  CANCELLED
}

enum TacticFrequency {
  DAILY
  WEEKLY
}
