generator client {
  provider = "prisma-client-js"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String             @id @default(cuid())
  name                    String?
  email                   String?            @unique
  emailVerified           DateTime?
  image                   String?
  passwordHash            String?
  privateTaskPasswordHash String?
  role                    Role               @default(ADMIN)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  systemStatus            SystemStatus       @default(STABLE)
  accounts                Account[]
  annualCompasses         AnnualCompass[]
  dailyEntries            DailyEntry[]
  dayPlans                DayPlan[]
  dayTemplates            DayTemplate[]
  dishes                  Dish[]
  habits                  Habit[]
  libraryItems            LibraryItem[]
  lifeSpheres             LifeSphere[]
  milestones              Milestone[]
  nutritionPerson         NutritionPerson?
  pushSubscriptions       PushSubscription[]
  sessions                Session[]
  shoppingLists           ShoppingList[]
  sprints                 Sprint[]
  tasks                   Task[]
  userLanguages           UserLanguage[]
  visions                 Vision[]
  weekPlans               WeekPlan[]
  wishlistItems           WishlistItem[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model NutritionPerson {
  id             String   @id @default(cuid())
  userId         String?  @unique
  name           String?
  targetCalories Float?   @default(2000)
  targetProtein  Float?   @default(150)
  targetFat      Float?   @default(70)
  targetCarbs    Float?   @default(200)
  targetFiber    Float?   @default(30)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id                String             @id @default(cuid())
  name              String
  category          ProductCategory    @default(OTHER)
  status            ProductStatus      @default(ACTIVE)
  source            ProductSource      @default(MANUAL)
  state             ProductState       @default(RAW)
  unit              Unit               @default(GRAM)
  calories          Float?
  protein           Float?
  fat               Float?
  carbs             Float?
  fiber             Float?
  price             Float?             @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  dishIngredients   DishIngredient[]
  shoppingListItems ShoppingListItem[]
}

model Dish {
  id              String             @id @default(cuid())
  userId          String
  name            String
  description     String?
  priority        Priority           @default(FLEXIBLE)
  yield           Float?             @default(1.0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  dayPlanEntries  DayPlanEntry[]
  templateEntries DayTemplateEntry[]
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients     DishIngredient[]
}

model DishIngredient {
  id                String               @id @default(cuid())
  dishId            String
  productId         String
  amount            Float
  unit              Unit                 @default(GRAM)
  inputState        IngredientInputState @default(RAW)
  preparationMethod PreparationMethod    @default(RAW)
  yieldFactor       Float                @default(1.0)
  dish              Dish                 @relation(fields: [dishId], references: [id], onDelete: Cascade)
  product           Product              @relation(fields: [productId], references: [id])

  @@unique([dishId, productId])
}

model DayTemplate {
  id        String             @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  dayPlans  DayPlan[]
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   DayTemplateEntry[]
}

model DayTemplateEntry {
  id         String      @id @default(cuid())
  templateId String
  dishId     String
  mealSlot   MealSlot
  servings   Float       @default(1)
  priority   Priority    @default(FLEXIBLE)
  dish       Dish        @relation(fields: [dishId], references: [id])
  template   DayTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model WeekPlan {
  id            String         @id @default(cuid())
  userId        String
  name          String?
  startDate     DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  dayPlans      DayPlan[]
  shoppingLists ShoppingList[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DayPlan {
  id         String         @id @default(cuid())
  userId     String
  weekPlanId String?
  templateId String?
  date       DateTime       @db.Date
  adherence  PlanAdherence  @default(PLANNED)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  template   DayTemplate?   @relation(fields: [templateId], references: [id])
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekPlan   WeekPlan?      @relation(fields: [weekPlanId], references: [id])
  entries    DayPlanEntry[]
}

model DayPlanEntry {
  id        String   @id @default(cuid())
  dayPlanId String
  dishId    String
  mealSlot  MealSlot
  servings  Float    @default(1)
  priority  Priority @default(FLEXIBLE)
  dayPlan   DayPlan  @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  dish      Dish     @relation(fields: [dishId], references: [id])
}

model ShoppingList {
  id         String             @id @default(cuid())
  userId     String
  weekPlanId String?
  name       String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekPlan   WeekPlan?          @relation(fields: [weekPlanId], references: [id])
  items      ShoppingListItem[]
}

model ShoppingListItem {
  id             String       @id @default(cuid())
  shoppingListId String
  productId      String
  amount         Float
  unit           Unit         @default(GRAM)
  checked        Boolean      @default(false)
  product        Product      @relation(fields: [productId], references: [id])
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
}

model LifeSphere {
  id         String      @id @default(cuid())
  userId     String
  name       String
  color      String
  icon       String
  order      Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  habits     Habit[]
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  objectives Objective[]
  tasks      Task[]
}

model Task {
  id                String       @id @default(cuid())
  userId            String
  title             String
  description       String?
  icon              String?
  status            TaskStatus   @default(TODO)
  priority          TaskPriority @default(MEDIUM)
  isPrivate         Boolean      @default(false)
  plannedDate       DateTime?
  hasPlannedTime    Boolean      @default(false)
  plannedEndDate    DateTime?
  hasPlannedEndTime Boolean      @default(false)
  dueDate           DateTime?
  hasDueTime        Boolean      @default(false)
  depth             Int          @default(0)
  order             Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  parentId          String?
  sphereId          String?
  projectId         String?
  completedAt       DateTime?
  isBlocked         Boolean      @default(false)
  parent            Task?        @relation("TaskChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children          Task[]       @relation("TaskChildren")
  project           Project?     @relation(fields: [projectId], references: [id])
  sphere            LifeSphere?  @relation(fields: [sphereId], references: [id])
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyEntry {
  id              String    @id @default(cuid())
  userId          String
  date            DateTime  @db.Date
  sleepBedtime    DateTime?
  sleepWakeup     DateTime?
  sleepHours      Float?
  sleepQuality    Int?
  sleepNote       String?
  energy          Int?
  mood            Int?
  emotions        Json?
  weight          Float?
  energyNote      String?
  eveningEnergy   Int?
  nutrition       Int?
  nutritionNote   String?
  morningRoutine  Json?
  eveningRoutine  Json?
  routineNote     String?
  winToday        String?
  improveTomorrow String?
  gratitude       String?
  brainDump       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  standupBlockers String?
  standupDone     String?
  standupPlan     String?
  recoveryRoutine Json?
  recoveryScore   Float?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Habit {
  id           String            @id @default(cuid())
  userId       String
  name         String
  anchor       String
  action       String
  celebration  String?
  reminderTime String?
  order        Int               @default(0)
  archived     Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sphereId     String?
  sphere       LifeSphere?       @relation(fields: [sphereId], references: [id])
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions  HabitCompletion[]
}

model HabitCompletion {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model LibraryItem {
  id        String            @id @default(cuid())
  userId    String
  title     String
  author    String?
  url       String?
  type      LibraryItemType   @default(BOOK)
  status    LibraryItemStatus @default(WANT_TO_READ)
  rating    Int?
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WishlistItem {
  id          String         @id @default(cuid())
  userId      String
  name        String
  description String?
  url         String?
  imageUrl    String?
  price       Float?
  currency    String         @default("UAH")
  priority    TaskPriority   @default(MEDIUM)
  status      WishlistStatus @default(WISH)
  category    String?
  tags        String[]
  necessity   Int?
  store       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Language {
  id            String         @id @default(cuid())
  name          String         @unique
  code          String         @unique
  icon          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userLanguages UserLanguage[]
}

model UserLanguage {
  id              String                   @id @default(cuid())
  userId          String
  languageId      String
  level           CefrLevel                @default(A0)
  totalXp         Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  immersionLogs   ImmersionLog[]
  resources       LanguageResource[]
  sphereProgress  LanguageSphereProgress[]
  language        Language                 @relation(fields: [languageId], references: [id])
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyItems VocabularyItem[]

  @@unique([userId, languageId])
}

model LanguageSphereProgress {
  id             String         @id @default(cuid())
  userLanguageId String
  sphere         LanguageSphere
  mastery        Float          @default(0)
  updatedAt      DateTime       @updatedAt
  userLanguage   UserLanguage   @relation(fields: [userLanguageId], references: [id], onDelete: Cascade)

  @@unique([userLanguageId, sphere])
}

model VocabularyItem {
  id             String       @id @default(cuid())
  userLanguageId String
  word           String
  translation    String
  context        String?
  notes          String?
  nextReview     DateTime     @default(now())
  interval       Int          @default(0)
  easeFactor     Float        @default(2.5)
  repetition     Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  userLanguage   UserLanguage @relation(fields: [userLanguageId], references: [id], onDelete: Cascade)

  @@index([nextReview])
}

model ImmersionLog {
  id             String         @id @default(cuid())
  userLanguageId String
  sphere         LanguageSphere
  duration       Int
  note           String?
  date           DateTime       @default(now())
  createdAt      DateTime       @default(now())
  userLanguage   UserLanguage   @relation(fields: [userLanguageId], references: [id], onDelete: Cascade)
}

model LanguageResource {
  id             String          @id @default(cuid())
  userLanguageId String
  name           String
  url            String?
  sphere         LanguageSphere?
  level          CefrLevel?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userLanguage   UserLanguage    @relation(fields: [userLanguageId], references: [id], onDelete: Cascade)
}

model Vision {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnnualCompass {
  id         String   @id @default(cuid())
  userId     String
  year       Int
  theme      String?
  wigs       String?
  focusAreas String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
}

model Milestone {
  id          String      @id @default(cuid())
  userId      String
  title       String
  description String?
  targetDate  DateTime?
  completed   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  sphereId    String?
  sphere      LifeSphere? @relation(fields: [sphereId], references: [id])
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sprint {
  id         String         @id @default(cuid())
  userId     String
  number     Int
  year       Int
  startDate  DateTime
  endDate    DateTime
  status     SprintStatus   @default(PLANNED)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  objectives Objective[]
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews    SprintReview[]
}

model Objective {
  id          String          @id @default(cuid())
  sprintId    String
  sphereId    String
  title       String
  description String?
  status      ObjectiveStatus @default(IN_PROGRESS)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  keyResults  KeyResult[]
  sphere      LifeSphere      @relation(fields: [sphereId], references: [id], onDelete: Cascade)
  sprint      Sprint          @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  projects    Project[]
}

model KeyResult {
  id           String    @id @default(cuid())
  objectiveId  String
  title        String
  targetValue  Float
  currentValue Float     @default(0)
  unit         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  objective    Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  tactics      Tactic[]
}

model Project {
  id          String     @id @default(cuid())
  objectiveId String
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      TaskStatus @default(TODO)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  objective   Objective  @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Tactic {
  id          String             @id @default(cuid())
  keyResultId String
  title       String
  description String?
  frequency   TacticFrequency    @default(WEEKLY)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  keyResult   KeyResult          @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  completions TacticCompletion[]
}

model TacticCompletion {
  id         String   @id @default(cuid())
  tacticId   String
  weekNumber Int
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  tactic     Tactic   @relation(fields: [tacticId], references: [id], onDelete: Cascade)

  @@unique([tacticId, weekNumber])
}

model SprintReview {
  id          String   @id @default(cuid())
  sprintId    String
  weekNumber  Int
  date        DateTime @db.Date
  score       Float?
  wins        String?
  challenges  String?
  adjustments String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sprint      Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}

enum ProductCategory {
  FRUITS
  VEGETABLES
  DAIRY
  MEAT
  POULTRY
  SEAFOOD
  GRAINS
  LEGUMES
  NUTS_SEEDS
  EGGS
  OILS_FATS
  SWEETS
  BEVERAGES
  BAKERY
  OTHER
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
  FAVORITE
}

enum ProductSource {
  MANUAL
  IMPORTED
}

enum ProductState {
  RAW
  COOKED
  PROCESSED
}

enum PreparationMethod {
  RAW
  BOILED
  FRIED
  BAKED
  STEAMED
  OTHER
}

enum SystemStatus {
  STABLE
  CRISIS_SURVIVAL
  CRISIS_STABILIZATION
  CRISIS_RE_ENTRY
}

enum IngredientInputState {
  RAW
  COOKED
}

enum Priority {
  FIXED
  FLEXIBLE
  AUTO
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum Unit {
  GRAM
  ML
  PIECE
  TBSP
  TSP
}

enum PlanAdherence {
  PLANNED
  FOLLOWED
  DEVIATED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LibraryItemType {
  BOOK
  ARTICLE
  VIDEO
  COURSE
  OTHER
}

enum LibraryItemStatus {
  WANT_TO_READ
  READING
  COMPLETED
  DROPPED
}

enum WishlistStatus {
  IDEA
  RESEARCHING
  WISH
  PLANNED
  ORDERED
  BOUGHT
  GIFTED
  ABANDONED
  REPLACED
  CANCELLED
}

enum LanguageSphere {
  VOCABULARY
  LISTENING
  READING
  SPEAKING
  WRITING
}

enum CefrLevel {
  A0
  A1
  A2
  B1
  B2
  C1
  C2
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ObjectiveStatus {
  IN_PROGRESS
  ACHIEVED
  PARTIAL
  FAILED
  CANCELLED
}

enum TacticFrequency {
  DAILY
  WEEKLY
}
